# Everything below has a working default. Copy to server/.env only if you want
# to change something — the app runs with no configuration at all.

PORT=8787

# Quote sources, highest priority first. `synthetic` is a deterministic offline
# market. Add `yahoo` for live NSE prices: PROVIDERS=yahoo,synthetic
# With two providers, disagreements are detected and flagged automatically.
PROVIDERS=synthetic

TICK_SECONDS=20

# Freshness ladder, in seconds since the exchange timestamp.
FRESH_LIVE_S=90
FRESH_DELAYED_S=900
FRESH_STALE_S=86400

# Cross-source price gap that marks a quote disputed (0.015 = 1.5%).
DISPUTE_THRESHOLD=0.015

# How fast an unread signal stops shouting.
ATTENTION_HALFLIFE_H=48

# Trailing daily bars for return stats and correlation, and the minimum
# overlapping sessions before a correlation is treated as measured.
STATS_WINDOW=120
MIN_OVERLAP=60

# Headline sentiment. Off by default: a lexicon model runs instead, and the
# product works identically without a key.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Sessions of history generated on first run.
HISTORY_DAYS=400
